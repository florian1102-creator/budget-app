# Port fuer das Web-Dashboard
PORT=3000

# Passwort fuer das Dashboard (HTTP Basic Auth). Unbedingt setzen, da hier
# personenbezogene Strafen-Daten der Mannschaft angezeigt werden.
DASHBOARD_PASSWORD=

# Zielgruppe: entweder Name (Teil-String reicht) ODER die feste Gruppen-JID
# (empfohlen fuer Dauerbetrieb, siehe README). Beim ersten Start ohne
# TARGET_GROUP_JID zeigt die Konsole alle Gruppen des verbundenen Accounts
# mit ihrer JID an.
TARGET_GROUP_NAME=Strafen TSV
TARGET_GROUP_JID=
